#compdef flux

_flux() {
  case $CURRENT in
    2)
      compadd add clone list remove pull dry-run cap pin config doctor version help
      ;;
    3)
      case "${words[2]}" in
        remove) compadd git dvc ;;
        pin)    compadd dvc git reset ;;
        cap)    compadd --reset ;;
      esac
      ;;
    4)
      if [[ "${words[2]}" == "pin" && "${words[3]}" == "reset" ]]; then
        compadd --all
      fi
      ;;
  esac
}

_flux "$@"
