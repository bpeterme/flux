#!/usr/bin/env bash
# Mock for Linux 'keyctl' CLI (keyutils).
# Simulates a kernel keyring using files in MOCK_KEYRING_DIR, keyed by
# description. The description is reused as the "key ID" flux gets back
# from `search`/`add` — good enough here, since flux only ever round-trips
# whatever ID keyctl handed it, never inspects it.

KR_DIR="${MOCK_KEYRING_DIR:-${HOME}/.mock-keyring}"
mkdir -p "$KR_DIR"

kr_file() { echo "${KR_DIR}/${1//./_}"; }

subcmd="${1:-}"; shift

case "$subcmd" in
  search)
    # search <keyring> <type> <description>
    description="$3"
    f=$(kr_file "$description")
    [[ -f "$f" ]] && echo "$description" && exit 0
    exit 1
    ;;
  add)
    # add <type> <description> <data> <keyring>
    description="$2"; data="$3"
    printf '%s' "$data" > "$(kr_file "$description")"
    echo "$description"
    exit 0
    ;;
  print)
    # print <id>
    id="$1"
    f=$(kr_file "$id")
    [[ -f "$f" ]] && cat "$f" && exit 0
    exit 1
    ;;
  unlink)
    # unlink <id> <keyring>
    id="$1"
    rm -f "$(kr_file "$id")"
    exit 0
    ;;
  *)
    echo "mock_keyctl: unhandled subcommand: $subcmd" >&2
    exit 1
    ;;
esac
