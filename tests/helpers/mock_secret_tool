#!/usr/bin/env bash
# Mock for Linux 'secret-tool' (libsecret), backed by files in MOCK_KEYCHAIN_DIR
# like mock_security. Logs its arguments, so tests can check that a stored
# value never appears on the command line.

KC_DIR="${MOCK_KEYCHAIN_DIR:-${HOME}/.mock-keychain}"
mkdir -p "$KC_DIR"
echo "$*" >> "$KC_DIR/.secret-tool-args"

subcmd="${1:-}"; shift
service=""
while [[ $# -gt 0 ]]; do
  case "$1" in service) service="$2"; shift 2 ;; *) shift ;; esac
done
f="${KC_DIR}/${service//./_}"

case "$subcmd" in
  lookup) [[ -f "$f" ]] && cat "$f" && exit 0; exit 1 ;;
  store)  cat > "$f"; exit 0 ;;
  clear)  rm -f "$f"; exit 0 ;;
  *) echo "mock_secret_tool: unhandled subcommand: $subcmd" >&2; exit 1 ;;
esac
