#!/usr/bin/env bash
# Mock DVC binary for flux tests.
# Simulates the DVC behaviour that the pre-commit hook depends on:
#   add  — creates <file>.dvc, appends /<basename> to sibling .gitignore
#   remove — removes <file>.dvc, deletes the .gitignore entry
#   cache dir — prints the repo's .dvc/cache path
#   checkout — restores targets from .dvc/cache; refuses unsaved edits
#   gc, init, remote, status, push, pull — no-ops (exit 0)
#
# Every invocation is appended to $MOCK_DVC_LOG for assertions.

set -euo pipefail

LOG="${MOCK_DVC_LOG:-/dev/null}"
echo "$*" >> "$LOG"

case "${1:-}" in
  add)
    shift
    file=""
    while [[ $# -gt 0 ]]; do
      [[ "$1" == --* ]] && { shift; continue; }
      file="$1"; shift
    done
    [[ -z "$file" ]] && exit 0

    dir=$(dirname "$file")
    base=$(basename "$file")

    cat > "${file}.dvc" << EOF
outs:
- md5: deadbeefdeadbeef00000000000000000
  path: ${base}
EOF

    gitignore="${dir}/.gitignore"
    if ! grep -qF "/${base}" "$gitignore" 2>/dev/null; then
      echo "/${base}" >> "$gitignore"
    fi
    ;;

  remove)
    shift
    dvc_file=""
    while [[ $# -gt 0 ]]; do
      [[ "$1" == --* ]] && { shift; continue; }
      dvc_file="$1"; shift
    done
    [[ -z "$dvc_file" ]] && exit 0

    target=$(grep '^\s*path:' "$dvc_file" 2>/dev/null \
      | head -1 | sed 's/.*path:[[:space:]]*//')
    dir=$(dirname "$dvc_file")

    gitignore="${dir}/.gitignore"
    if [[ -f "$gitignore" && -n "$target" ]]; then
      sed -i.bak "/^\/${target}$/d" "$gitignore" \
        && rm -f "${gitignore}.bak"
    fi

    rm -f "$dvc_file"
    ;;

  init)
    # Create minimal .dvc/config so setup.sh can stage it
    mkdir -p .dvc
    printf '' > .dvc/config
    ;;

  remote)
    shift
    remote_subcmd="${1:-}"; shift || true
    if [[ "$remote_subcmd" == "add" ]]; then
      remote_name="" remote_url=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -f|--quiet|--local) shift ;;
          *) [[ -z "$remote_name" ]] && remote_name="$1" || remote_url="$1"; shift ;;
        esac
      done
      if [[ -n "$remote_name" ]]; then
        mkdir -p .dvc
        printf '[core]\n    remote = %s\n[%s]\n    url = %s\n' \
          "$remote_name" "$remote_name" "${remote_url:-}" >> .dvc/config
      fi
    fi
    exit 0
    ;;

  status)
    # If MOCK_DVC_STATUS_FILE points to a file, print its contents to simulate
    # locally modified DVC-tracked files; otherwise report clean (no output).
    if [[ -f "${MOCK_DVC_STATUS_FILE:-}" ]]; then
      cat "$MOCK_DVC_STATUS_FILE"
    fi
    exit 0
    ;;

  push)
    if [[ "${MOCK_DVC_PUSH_FAIL:-0}" == "1" ]]; then
      echo "mock_dvc: simulated push failure" >&2
      exit 1
    fi
    exit 0
    ;;

  checkout)
    # Restores each given pointer's target from the local cache (DVC 3
    # layout). Like real DVC it is all-or-nothing: if any target has content
    # that is not in the cache (unsaved edits) and --force is not given,
    # nothing is restored and it fails.
    shift
    force=0 todo=()
    _md5() { if command -v md5sum >/dev/null; then md5sum "$1" | cut -d' ' -f1; else md5 -q "$1"; fi; }
    for arg in "$@"; do
      case "$arg" in --force|-f) force=1 ;; --*) ;; *) [[ -f "$arg" ]] && todo+=("$arg") ;; esac
    done
    for arg in ${todo[@]+"${todo[@]}"}; do
      target="$(dirname "$arg")/$(sed -n 's/^[[:space:]]*path:[[:space:]]*//p' "$arg" | head -1)"
      if [[ -f "$target" && $force -eq 0 ]]; then
        cur=$(_md5 "$target")
        if [[ ! -f ".dvc/cache/files/md5/${cur:0:2}/${cur:2}" ]]; then
          echo "ERROR: Can't remove the following unsaved files without confirmation. Use \`--force\` to force." >&2
          echo "$target" >&2
          exit 255
        fi
      fi
    done
    for arg in ${todo[@]+"${todo[@]}"}; do
      md5=$(sed -n 's/^[-[:space:]]*md5:[[:space:]]*//p' "$arg" | head -1)
      target="$(dirname "$arg")/$(sed -n 's/^[[:space:]]*path:[[:space:]]*//p' "$arg" | head -1)"
      obj=".dvc/cache/files/md5/${md5:0:2}/${md5:2}"
      [[ -f "$obj" ]] || { echo "ERROR: missing cache for $target" >&2; exit 1; }
      cp "$obj" "$target"
    done
    exit 0
    ;;

  cache)
    [[ "${2:-}" == "dir" ]] && echo "$PWD/.dvc/cache"
    exit 0
    ;;

  gc|pull|version)
    exit 0
    ;;

  *)
    echo "mock_dvc: unhandled command: $*" >&2
    exit 1
    ;;
esac
